# ============================================================================
# CASL Semantic Cache Configuration
# ============================================================================
#
# This file shows all available cache configuration options.
# Copy this to .env and configure as needed.
#
# By default, caching is DISABLED (REDIS_ENABLED=false) so existing
# deployments are not affected. Set REDIS_ENABLED=true to activate.

# ============================================================================
# Redis Connection Settings
# ============================================================================

# Enable/disable semantic caching layer
# Default: false (cache disabled, no impact on existing behavior)
REDIS_ENABLED=false

# Redis connection URL
# Default: redis://localhost:6379
# Examples:
#   redis://localhost:6379
#   redis://user:password@redis.example.com:6379/0
#   rediss://secure-redis.example.com:6380
REDIS_URL=redis://localhost:6379

# Redis connection timeout in seconds
# Default: 2 seconds
# If Redis is slow or unreachable, cache operations timeout gracefully
REDIS_TIMEOUT=2

# ============================================================================
# Cache Matching Thresholds
# ============================================================================

# Cosine distance threshold for semantic matching (Tier 2)
# Range: 0.0 to 1.0
# Default: 0.08 (requires ~99% vector similarity)
# Higher = more lenient matching, faster responses but less precision
# Lower = stricter matching, higher precision but potentially more cache misses
#
# Guideline:
#   0.05  = Very strict, ~99.95% similarity required (fewest false positives)
#   0.08  = Recommended default, ~99% similarity required
#   0.12  = More lenient, ~98.8% similarity required (fewer cache misses)
#   0.15  = Very lenient, ~98.5% similarity required (potential false positives)
CACHE_SIMILARITY_THRESHOLD=0.08

# ============================================================================
# Cache Lifetime & Memory Management
# ============================================================================

# Cache TTL (time-to-live) in seconds
# Default: 86400 (24 hours)
# Set lower to reduce memory usage, higher for better cache hit rates
CACHE_TTL=86400

# Maximum number of cache entries per tenant (soft limit)
# Default: 10000
# When exceeded, oldest entries are discarded (FIFO)
# Prevents unbounded memory growth under high throughput
CACHE_MAX_ENTRIES=10000

# ============================================================================
# Deployment Notes
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (no Redis):
#    - Leave REDIS_ENABLED=false
#    - Cache layer is completely disabled
#    - System behaves identically to before caching was added
#
# 2. STAGING (test with Redis):
#    - Set REDIS_ENABLED=true
#    - Point REDIS_URL to staging Redis instance
#    - Observe cache stats at /cache/stats endpoint
#    - Monitor cache hit rates
#
# 3. PRODUCTION ROLLOUT:
#    - Start with REDIS_ENABLED=true in a canary deployment
#    - Monitor /cache/stats for hit rate and errors
#    - Adjust CACHE_SIMILARITY_THRESHOLD based on hit rate vs precision
#    - If issues arise, disable with REDIS_ENABLED=false (no downtime)
#
# 4. REDIS FAILURE HANDLING:
#    - If Redis is unavailable, all operations silently skip caching
#    - Requests proceed normally without cached responses
#    - Zero impact on latency or functionality
#    - Check /cache/stats to see Redis connection status
#
# ============================================================================
# Observability
# ============================================================================
#
# Monitor cache health at:
#   GET /cache/stats
#
# Response includes:
#   - hits: Number of cache hits since startup
#   - misses: Number of cache misses
#   - hit_rate_percent: Cache hit rate as percentage
#   - redis_errors: Connection/operational errors
#   - is_redis_connected: Current Redis connectivity status
#   - last_error: Most recent error message (if any)
#
# ============================================================================

# ============================================================================
# CASL Enterprise Security Guardrails
# ============================================================================
#
# This section configures prompt injection defense and PII masking.
# By default, all security features are DISABLED (SECURITY_ENABLED=false)
# so existing deployments are not affected.

# ============================================================================
# Master Security Feature Flags
# ============================================================================

# Enable/disable entire security guardrails layer
# Default: false (security disabled, no impact on existing behavior)
# Set to true to activate PII masking + injection detection + output validation
SECURITY_ENABLED=false

# Enable PII masking (redact emails, phones, API keys, IPs, SSNs)
# Default: true (when SECURITY_ENABLED=true)
# Can be disabled independently to test injection detection only
PII_MASKING_ENABLED=true

# Enable prompt injection detection (detect override patterns, jailbreaks, escapes)
# Default: true (when SECURITY_ENABLED=true)
PII_MASKING_ENABLED=true

# Enable output validation (check for leaked secrets in responses)
# Default: true (when SECURITY_ENABLED=true)
OUTPUT_VALIDATION_ENABLED=true

# ============================================================================
# Safe-Mode & Failure Handling
# ============================================================================

# Enable safe-mode: allow requests through if security layer fails
# Default: true (graceful degradation)
# If false and security fails, request is rejected (strict mode)
SECURITY_SAFE_MODE=true

# ============================================================================
# Input Validation Thresholds
# ============================================================================

# Maximum input context size in bytes
# Default: 50000 (50KB)
# Prevents processing of extremely large payloads
MAX_CONTEXT_SIZE=50000

# Maximum number of lines in input context
# Default: 1000
MAX_CONTEXT_LINES=1000

# ============================================================================
# Injection Detection Configuration
# ============================================================================

# Severity threshold for blocking requests
# Values: CRITICAL, HIGH, MEDIUM, LOW
# Default: HIGH (block CRITICAL and HIGH severity injections)
# CRITICAL: Always block (ignore instructions, system prompt overrides)
# HIGH: Block by default (new instructions, jailbreak attempts)
# MEDIUM: Log but allow (constraint removal, escape attempts)
# LOW: Allow (general pattern matches)
INJECTION_SEVERITY_THRESHOLD=HIGH

# Confidence threshold for injection detection (0.0 to 1.0)
# Default: 0.7 (70% confidence required to flag)
# Higher = fewer false positives but may miss attacks
# Lower = catch more attacks but more false positives
INJECTION_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# PII Masking Configuration
# ============================================================================

# Individually enable/disable PII types
PII_MASK_EMAILS=true
PII_MASK_PHONES=true
PII_MASK_API_KEYS=true
PII_MASK_IPS=true
PII_MASK_SSNS=true

# ============================================================================
# Performance & Regex Settings
# ============================================================================

# Timeout for regex operations in seconds
# Default: 2.0 seconds
# Prevents regex denial-of-service on malicious input
REGEX_TIMEOUT_SECONDS=2.0

# Maximum number of patterns to scan
# Default: 100
# Limits scanning scope to prevent performance degradation
MAX_PATTERNS_TO_SCAN=100

# ============================================================================
# Logging & Observability
# ============================================================================

# Log all sanitization operations (verbose)
# Default: false
LOG_ALL_SANITIZATION=false

# Log all security violations
# Default: true
LOG_ALL_VIOLATIONS=true

# ============================================================================
# Deployment Notes
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (no security):
#    - Leave SECURITY_ENABLED=false
#    - Security layer is completely disabled
#    - System behaves identically to before security was added
#
# 2. STAGING (test with full security):
#    - Set SECURITY_ENABLED=true
#    - Set INJECTION_SEVERITY_THRESHOLD=HIGH (recommended)
#    - Observe security stats at /security/stats endpoint
#    - Monitor false positives in application logs
#
# 3. PRODUCTION ROLLOUT:
#    - Start with canary (1% traffic) with SECURITY_ENABLED=true
#    - Monitor /security/stats for injection detection rate
#    - Adjust INJECTION_CONFIDENCE_THRESHOLD if needed
#    - If issues arise, disable with SECURITY_ENABLED=false (no downtime)
#
# 4. SECURITY FAILURE HANDLING:
#    - If security layer fails, safe-mode allows requests through
#    - Safe-mode activations logged for audit trail
#    - Check /security/stats for recent activation history
#
# ============================================================================
# Observability
# ============================================================================
#
# Monitor security health at:
#   GET /security/stats
#
# Response includes:
#   - pii_redacted: Count of redacted PII by type
#   - injections_detected: Count of detected injections by type
#   - output_violations: Count of response validation violations
#   - blocking_events: Requests blocked by severity
#   - last_events: Most recent activity timestamps
#
# ============================================================================

# ============================================================================
# OpenTelemetry Distributed Tracing Configuration
# ============================================================================
#
# This section configures distributed tracing with OpenTelemetry.
# By default, telemetry is DISABLED (TELEMETRY_ENABLED=false)
# so existing deployments are not affected.

# ============================================================================
# Master Telemetry Feature Flag
# ============================================================================

# Enable/disable OpenTelemetry tracing
# Default: false (telemetry disabled, no impact on existing behavior)
# Set to true to activate distributed tracing, token metrics, and observability
TELEMETRY_ENABLED=false

# ============================================================================
# OpenTelemetry Exporter Configuration
# ============================================================================

# OTEL gRPC exporter endpoint (Jaeger Collector or OTEL Collector)
# Default: http://localhost:4317
# Examples:
#   http://localhost:4317 (local Jaeger/OTEL Collector)
#   http://jaeger.monitoring.svc.cluster.local:4317 (Kubernetes)
#   https://otel.example.com:4317 (remote OTEL Collector with TLS)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name for all exported traces
# Default: casl-backend
# Used in Jaeger/Grafana Tempo for service identification
OTEL_SERVICE_NAME=casl-backend

# Trace sampler configuration
# Default: parentbased_traceidratio (respects parent trace context)
# Options:
#   parentbased_traceidratio: Follow parent if available, else use sampler_arg
#   always_on: Trace all requests (high overhead, dev only)
#   always_off: Disable tracing
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampler argument (0.0 to 1.0) for samplers that use it
# Default: 0.1 (10% of traces)
# Use 1.0 for development, 0.1-0.01 for production to reduce overhead
OTEL_TRACES_SAMPLER_ARG=0.1

# ============================================================================
# Alternative: Jaeger Exporter (Optional)
# ============================================================================

# Enable Jaeger exporter (instead of OTEL gRPC)
# Default: false (uses OTEL gRPC by default)
JAEGER_ENABLED=false

# Jaeger agent hostname
# Default: localhost
JAEGER_HOST=localhost

# Jaeger agent port (Thrift compact)
# Default: 6831
JAEGER_PORT=6831

# ============================================================================
# Token Metrics & Budgeting Configuration
# ============================================================================

# Enable token tracking and cost accounting
# Default: false (metrics disabled)
# Set to true to track token consumption per tenant/model/route
TOKEN_METRICS_ENABLED=false

# Default monthly budget per tenant in USD
# Default: 100.0
# Used for soft-limit warnings and cost tracking
TENANT_MONTHLY_BUDGET_USD=100.0

# Budget warning threshold (0.0 to 1.0)
# Default: 0.8 (80%)
# Emit warnings when tenant usage reaches this percentage of budget
TENANT_BUDGET_WARN_THRESHOLD=0.8

# ============================================================================
# LLM Pricing Configuration (for cost calculation)
# ============================================================================

# Cost per 1K input tokens (OpenAI GPT-4 pricing as reference)
# Default: 0.0015 ($0.0015 per 1K tokens)
COST_PER_1K_INPUT_TOKENS=0.0015

# Cost per 1K output tokens
# Default: 0.006 ($0.006 per 1K tokens)
COST_PER_1K_OUTPUT_TOKENS=0.006

# ============================================================================
# Deployment Notes
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (no tracing):
#    - Leave TELEMETRY_ENABLED=false
#    - Tracing layer is completely disabled
#    - System behaves identically to before tracing was added
#
# 2. STAGING (test with distributed tracing):
#    - Set TELEMETRY_ENABLED=true
#    - Set OTEL_TRACES_SAMPLER_ARG=1.0 (100% sampling)
#    - Start Jaeger: docker run -d -p 6831:6831/udp -p 16686:16686 jaegertracing/all-in-one
#    - Visit http://localhost:16686 to see traces
#    - Observe end-to-end request flow through retrieval, LLM, caching layers
#
# 3. PRODUCTION ROLLOUT:
#    - Set TELEMETRY_ENABLED=true
#    - Set OTEL_TRACES_SAMPLER_ARG=0.1 (10% sampling to reduce overhead)
#    - Configure OTEL_EXPORTER_OTLP_ENDPOINT to production Jaeger/Tempo
#    - Set TOKEN_METRICS_ENABLED=true to track costs
#    - Monitor /telemetry/metrics endpoint for token consumption
#
# 4. PERFORMANCE IMPACT:
#    - With 10% sampling: <1% latency overhead
#    - With 100% sampling: <5% latency overhead
#    - Disable (TELEMETRY_ENABLED=false) if overhead is unacceptable
#
# ============================================================================
# LLM Evaluation Harness Configuration
# ============================================================================
#
# This section configures evaluation pipeline for automated quality testing.
# By default, evaluation is DISABLED (EVALS_ENABLED=false).

# ============================================================================
# Master Evaluation Feature Flag
# ============================================================================

# Enable/disable LLM evaluation harness
# Default: false (evaluation disabled, no impact on production)
# Set to true to activate evaluation pipeline for CI/CD gating
EVALS_ENABLED=false

# ============================================================================
# Sampling & Dataset Configuration
# ============================================================================

# Number of samples per evaluation run
# Default: 20 (fast PR check)
# Options: 20 (PR), 50 (main), 100 (release), 500 (full)
EVAL_SAMPLE_SIZE=20

# Judge LLM model for evaluation scoring
# Default: ollama:local (zero cost)
# Options:
#   ollama:local - Local Ollama model (free, ~1-2 min per run)
#   openai:gpt-3.5-turbo - GPT-3.5 ($0.001 per call, ~30 sec per run)
#   openai:gpt-4 - GPT-4 ($0.03 per call, ~1 min per run)
EVAL_JUDGE_MODEL=ollama:local

# Enable fast mode (smaller dataset, fewer metrics)
# Default: true (for PR checks)
EVAL_FAST_MODE=true

# Cache evaluation scores to avoid re-scoring identical inputs
# Default: true (reduces cost)
EVAL_CACHE_SCORES=true

# Random seed for reproducible dataset splitting
# Default: 42
EVAL_SEED=42

# Evaluation tier for sampling strategy
# Options: pr_check, main_merge, release, full
# Default: pr_check
EVAL_TIER=pr_check

# ============================================================================
# Evaluation Directories
# ============================================================================

# Directory for storing evaluation datasets
# Default: evals/datasets
EVAL_DATASET_DIR=evals/datasets

# Directory for storing evaluation results
# Default: evals/results
EVAL_RESULTS_DIR=evals/results

# Cache directory for score caching
# Default: evals/.cache
EVAL_CACHE_DIR=evals/.cache

# ============================================================================
# Cost Control
# ============================================================================

# Maximum monthly evaluation cost (USD)
# Default: 50.0
# Evaluations will warn if approaching this limit
EVAL_MAX_MONTHLY_COST_USD=50.0

# Timeout per evaluation (seconds)
# Default: 30
EVAL_TIMEOUT_SECONDS=30

# ============================================================================
# Deployment Notes
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (no evaluation):
#    - Leave EVALS_ENABLED=false
#    - Evaluation disabled, no impact on development
#    - System behaves identically to before evaluation was added
#
# 2. STAGING (test with evaluation):
#    - Set EVALS_ENABLED=true
#    - Set EVAL_JUDGE_MODEL=ollama:local (free, requires local Ollama)
#    - Set EVAL_SAMPLE_SIZE=50 (full coverage testing)
#    - Run evaluation manually: python -m evals eval_harness
#    - Monitor results at evals/results/ directory
#
# 3. CI/CD PIPELINE:
#    - GitHub Actions workflow in .github/workflows/eval_pipeline.yml
#    - Runs automatically on PR with EVAL_TIER=pr_check (20 samples, 2 min)
#    - Gates merge on metric thresholds: faithfulness≥0.85, relevance≥0.80
#    - Allows 2% regression threshold to accommodate noise
#    - Results commented on PR for visibility
#    - Add 'skip-eval' label to bypass evaluation if needed
#
# 4. COST CONTROL:
#    - PR checks: 20 samples, ollama:local = $0/run
#    - Main merges: 50 samples, ollama:local = $0/run
#    - Releases: 100 samples, ollama:local = $0/run
#    - Full evaluation: 500 samples, GPT-3.5 = ~$0.50/run
#    - Use EVAL_MAX_MONTHLY_COST_USD to cap spending
#
# 5. EVALUATION REGRESSION HANDLING:
#    - Detector distinguishes real regressions from noise/variance
#    - Stability check: Flag evaluator if variance > 5%
#    - Confidence-based gating: Low confidence if baseline unstable
#    - Example categorization: Group regressions by type
#
# ============================================================================
# Multi-Agent Context Verification Engine
# ============================================================================
#
# This section configures autonomous multi-agent context verification
# using LangGraph for planner, searcher, and verifier agents.
# By default, agents are DISABLED (AGENTS_ENABLED=false).

# ============================================================================
# Master Agent Feature Flag
# ============================================================================

# Enable/disable multi-agent context verification
# Default: false (agents disabled, no impact on production)
# Set to true to activate agent-based context verification
AGENTS_ENABLED=false

# ============================================================================
# Agent Configuration
# ============================================================================

# Maximum retries (planner → searcher → verifier cycles)
# Default: 3
# Higher = more thorough verification, longer latency
AGENTS_MAX_RETRIES=3

# Graph execution timeout in seconds
# Default: 30
# Timeout = force pass with best-effort results
AGENTS_TIMEOUT_SECONDS=30

# External search provider
# Options: tavily (recommended), serper
# Default: tavily
AGENTS_SEARCH_PROVIDER=tavily

# Enable result caching (Redis for search results)
# Default: true
# Reduces API calls for duplicate queries
AGENTS_CACHE_SEARCH_RESULTS=true

# Cache TTL in hours
# Default: 24
AGENTS_CACHE_TTL_HOURS=24

# Enable streaming events for long-running executions
# Default: false
AGENTS_STREAMING_ENABLED=false

# ============================================================================
# Search API Configuration
# ============================================================================

# Tavily API key (free tier: 1000 searches/month)
# Get key from https://www.tavily.com/
TAVILY_API_KEY=

# Serper API key (alternative to Tavily)
# Get key from https://serper.dev/
SERPER_API_KEY=

# ============================================================================
# Performance Tuning
# ============================================================================

# Run searches in parallel (default: true)
AGENTS_PARALLEL_SEARCHES=true

# Maximum concurrent searches
# Default: 5
AGENTS_MAX_CONCURRENT_SEARCHES=5

# Skip verifier if searcher returns empty results
# Default: true (optimization)
AGENTS_SKIP_VERIFIER_ON_EMPTY=true

# Cache LLM responses for identical inputs
# Default: true
AGENTS_CACHE_LLM_RESPONSES=true

# ============================================================================
# Cost Control
# ============================================================================

# Maximum monthly agent cost in USD
# Default: 100.0
# Estimated with GPT-3.5: $1-2/month with free search tier
AGENTS_MAX_MONTHLY_COST_USD=100.0

# LLM model for planner/verifier agents
# Options: gpt-3.5-turbo (cheap), gpt-4 (powerful), claude-3
# Default: gpt-3.5-turbo
AGENTS_LLM_MODEL=gpt-3.5-turbo

# ============================================================================
# Safety & Monitoring
# ============================================================================

# Latency threshold for circuit breaker (milliseconds)
# Default: 5000 (5 seconds)
# Exceeding this threshold auto-disables agents
AGENTS_LATENCY_THRESHOLD_MS=5000

# Failure threshold for circuit breaker
# Default: 5
# Disable agents after N consecutive high-latency executions
AGENTS_FAILURE_THRESHOLD=5

# Recovery time for circuit breaker (seconds)
# Default: 600 (10 minutes)
# Time to wait before retrying after circuit opens
AGENTS_RECOVERY_TIME_SECONDS=600

# ============================================================================
# Deployment Notes
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (no agents):
#    - Leave AGENTS_ENABLED=false
#    - Agents completely disabled, zero impact
#    - System behaves identically to before agents added
#
# 2. STAGING (test with agents):
#    - Set AGENTS_ENABLED=true
#    - Set TAVILY_API_KEY (free tier)
#    - Test via new /search/verified endpoint
#    - Monitor /agents/metrics for health/performance
#
# 3. PRODUCTION ROLLOUT:
#    - Start with AGENTS_ENABLED=false (keep baseline)
#    - Gradually enable with feature flag for specific tenants
#    - Monitor costs: Estimated $1-2/month with GPT-3.5 + Tavily
#    - Circuit breaker auto-disables if latency > 5s
#
# 4. COST ESTIMATION:
#    - Tavily search: FREE (1000/month)
#    - GPT-3.5 planner: $0.001/request
#    - GPT-3.5 verifier: $0.001-0.01/request (variable)
#    - Total/request: $0.002-0.02 (avg $0.01)
#    - 1000 requests/month: $10-20
#    - Use GPT-4 for higher quality ($0.10/request)
#
# 5. FAILURE MODES & MITIGATIONS:
#    - Infinite loops: LoopDetector stops after 3 repeats
#    - Low search quality: SearchQualityGate stops after 2 empty attempts
#    - High latency: CircuitBreaker auto-disables after 5 consecutive >5s
#    - LLM output invalid: LLMOutputValidator catches format errors
#
# 6. OBSERVABILITY:
#    - Health endpoint: GET /agents/metrics
#    - Metrics: success rate, latency (p50, p95), coverage
#    - Logging: Full trace of planner/searcher/verifier decisions
#
# ============================================================================
# Observability
# ============================================================================
#
# Monitor agent health at:
#   GET /agents/metrics
#
# Response includes:
#   - enabled: Boolean, agent system enabled or not
#   - healthy: Overall health status
#   - metrics: Aggregated stats (success rate, latency percentiles, coverage)
#
# Monitor other metrics at:
#   GET /telemetry/metrics
#
# Response includes:
#   - tokens_consumed: Total tokens by tenant/model/route
#   - cost_usd: Total cost spent by tenant
#   - budget_remaining: Remaining budget per tenant
#   - usage_percent: Percent of monthly budget used
#
# View traces in Jaeger:
#   GET http://localhost:16686 (after docker run above)
#
# Trace hierarchy:
#   - http.request (root)
#     ├── security.pii_detection
#     ├── cache.lookup / cache.write
#     ├── retrieval.hybrid
#     │   ├── retrieval.dense
#     │   └── retrieval.sparse
#     ├── reranking
#     ├── llm.generation
#     │   ├── circuit_breaker
#     │   └── provider_latency_ms
#     └── task.extraction / task.embedding (async)
#
# ============================================================================
